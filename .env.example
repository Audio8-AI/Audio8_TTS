# Required runtime locations
PYTHON=/opt/venvs/audio8-falcon/bin/python
FISH_SPEECH_ROOT=/opt/src/fish-speech
MODEL=/models/audio8/audio8_tts_0_1b_export
AUDIO8_INIT_MODEL=/models/audio8_tts_falcon_h1_tiny_init
HOSTFILE=/etc/deepspeed/hostfile

# Shared storage
TRAIN_JSONL=/datasets/audio8/train.jsonl
CODE_SHARD_DIR=/datasets/audio8/code_shards
LOCAL_NPY_CACHE_SOURCE_PREFIX=/datasets/audio8/codes
OUTPUT_ROOT=/checkpoints/audio8-falcon/outputs
EXPORT_ROOT=/checkpoints/audio8-falcon/exports
CACHE_ROOT=/local-cache/audio8-falcon
RUNTIME_ROOT=/dev/shm/audio8-falcon

# Distributed topology
NUM_NODES=3
NUM_GPUS=8
# MASTER_ADDR is optional; the first hostfile entry is used when omitted.
MASTER_PORT=29618

# Only v1/v2 datasets backed by object storage require these.
OSS_ENDPOINT=
OSS_REGION=
ARK_OSS_ADDRESSING_STYLE=virtual
OSS_ACCESS_KEY_ID=
OSS_SECRET_ACCESS_KEY=

# GRPO reward assets
SEEDTTS_ROOT=/models/seed-tts-eval
OMNIVOICE_REPO=/opt/src/OmniVoice
WHISPER_PATH=/models/whisper-large-v3
ARK_ASR_PATH=/models/ark_asr_v1.1
REWARD_EXTRA_PYTHONPATH=
